pipeline {
    agent any // Запуск на любом доступном агенте (ноде)

    options {
        buildDiscarder(logRotator(numToKeepStr: '10')) // Сохранять только последние 10 сборок
        timeout(time: 1, unit: 'HOURS') // Таймаут выполнения сборки — 1 час
    }

    environment {
        APP_NAME = 'my-application'
    }

    stages {
        stage('Checkout') {
            steps {
                git url: 'https://github.com/Oops77-m/lesson26-27.git', branch: 'master'
            }
        }

        stage('Build') {
            steps {
                sh 'echo "Build project"'
                sh 'dotnet restore'
                sh 'dotnet build'
            }
        }

        stage('Test') {
            steps {
                echo 'Start Testing'
                sh 'dotnet test'
            }
            }
    }
    post {
        always {
            allure([ results: [[path: 'allure-results']]])
          }
}
}